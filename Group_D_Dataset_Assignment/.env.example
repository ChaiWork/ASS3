# ==============================================================================
# Group D — NLP Dataset Design & Collection (STINK3114)
# Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to `.env` and populate your own API credentials if collecting
# via the authenticated YouTube Data API v3 endpoint.
# NEVER commit `.env` or expose real API keys in source code or repositories.
# ==============================================================================

# 1. YouTube Data API v3 Configuration (Google Cloud Console)
# Obtain from: https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" in your Google Cloud project.
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# 2. Collection Mode ("auto", "api_v3", or "public_innertube")
# - "auto": Uses Official YouTube Data API v3 if YOUTUBE_API_KEY is set;
#           otherwise falls back to public YouTube Innertube web pagination.
COLLECTION_MODE=auto

# 3. Reproducibility & Rate Limiting Parameters
RANDOM_SEED=42
MAX_COMMENTS_PER_VIDEO=80
REQUEST_TIMEOUT_SECONDS=15
RATE_LIMIT_SLEEP_SECONDS=0.5

